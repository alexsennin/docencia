{
  "name": "docencia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "local:init-env": "node scripts/init-local-env.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:local": "node db/seed-local.mjs",
    "db:smoke": "node --conditions=react-server --experimental-strip-types db/smoke.ts",
    "backup:postgres": "node scripts/backup-postgres.mjs",
    "verify:postgres-backup": "node scripts/backup-postgres.mjs",
    "build:ca-rubric-worker": "node scripts/build-ca-rubric-worker.mjs",
    "test:student-access": "node --test tests/student-access.integration.mjs",
    "test:teacher-session": "node --conditions=react-server --experimental-strip-types --test tests/teacher-session.integration.mjs",
    "test:grade-snapshot": "node --conditions=react-server --experimental-strip-types --test tests/grade-snapshot-postgres.integration.mjs",
    "test:exam-attempt": "node --conditions=react-server --experimental-strip-types --test tests/exam-attempt-postgres.integration.mjs",
    "test:exam-authoring": "node --conditions=react-server --experimental-strip-types --test tests/exam-authoring-postgres.integration.mjs",
    "test:ca-rubric": "node --conditions=react-server --experimental-strip-types --test tests/ca-rubric-postgres.integration.mjs",
    "test:academic-report": "node --conditions=react-server --experimental-strip-types --test tests/academic-report-postgres.integration.mjs",
    "test:teacher-preview": "node --conditions=react-server --experimental-strip-types --test tests/teacher-preview-postgres.integration.mjs",
    "test:academic": "node --experimental-strip-types --test tests/academic-engine.test.mjs",
    "test:academic-archive": "node --experimental-strip-types --test tests/academic-archive.test.mjs",
    "test:data-backend": "node --experimental-strip-types --test tests/data-backend.test.mjs",
    "reconcile:sheets-snapshot": "node scripts/reconcile-sheets-snapshot.mjs",
    "test:sheets-reconcile": "node --test tests/sheets-snapshot-reconcile.test.mjs",
    "test:sheets-schema-contract": "node --conditions=react-server --experimental-strip-types --test tests/sheets-schema-contract.test.mjs",
    "import:sheets-snapshot": "node scripts/import-sheets-snapshot-to-postgres.mjs",
    "test:sheets-import": "node --test tests/sheets-postgres-import.test.mjs"
  },
  "dependencies": {
    "@neon/functions": "^0.11.0",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.3",
    "mammoth": "^1.12.3",
    "next": "16.3.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "eslint": "^9.22.0",
    "eslint-config-next": "16.3.6",
    "typescript": "^5.8.0"
  }
}
