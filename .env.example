# Add only non-secret variable names here.
GOOGLE_SHEETS_SPREADSHEET_ID=1YcnvSaHeIpZrbthI8rNOKIEJy0Z6QQ-06VCROS4Yh48
GOOGLE_SHEETS_SHEET_NAME=Registros
# Server-to-server bridge. Never expose the URL token to the browser.
GOOGLE_SHEETS_BRIDGE_URL=
GOOGLE_SHEETS_BRIDGE_TOKEN=
# Keep DATA_BACKEND on the default Sheets backend in Production until end-to-end, backup/restore, and rollback gates pass.
DATA_BACKEND=sheets
# Set to YES only as part of an approved production cutover after all migration gates pass.
POSTGRES_PRODUCTION_CUTOVER_APPROVED=
# Keep this in Vercel/Apps Script project properties, never in source control.
EXAM_UNLOCK_PASSWORD=
# Password-only teacher login; set both as sensitive Production variables in Vercel.
TEACHER_PASSWORD=
TEACHER_SESSION_SECRET=
# AI credentials stay server-side. Use the ignored local env file for Docker and sensitive Vercel variables in Production.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
